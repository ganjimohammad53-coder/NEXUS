# Copy to deploy/.env and replace every example value. Never commit deploy/.env.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-database-password
NEXUS_ADMIN_EMAIL=admin@example.com
NEXUS_ADMIN_PASSWORD=replace-with-at-least-16-characters-and-unique
NEXUS_AUTH_RATE_PER_MINUTE=60
NEXUS_GLOBAL_RATE_PER_MINUTE=100000
