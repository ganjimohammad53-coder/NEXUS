<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexus.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="NexusAccent" Color="#8B5CF6" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#07080D" />
      <Setter Property="Foreground" Value="#F4F5FA" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI" />
    </Style>

    <!-- Scrollbars: slim and quiet -->
    <Style Selector="ScrollBar:vertical /template/ Border#Track">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A7A9BC" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A1B2B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2E3048" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22233A" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#241C45" />
      <Setter Property="BorderBrush" Value="#5B45A8" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#241C45" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#5B45A8" />
      <Setter Property="BoxShadow" Value="0 4 22 #305B45A8" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2B2154" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#7A62D0" />
    </Style>

    <!-- Primary button: accent fill with soft glow -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource NexusAccent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 6 22 #407C5CE0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A98BFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BoxShadow" Value="0 8 30 #707C5CE0" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6D4BD1" />
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Secondary button: glassy outline -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#1A1B2A" />
      <Setter Property="Foreground" Value="#E7E8F1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33354D" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#262843" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#5B5E8A" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F2037" />
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#10111B" />
      <Setter Property="Foreground" Value="#F4F5FA" />
      <Setter Property="BorderBrush" Value="#2B2D44" />
      <Setter Property="SelectionBrush" Value="#6D4BD1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="13,10" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#141524" />
      <Setter Property="BorderBrush" Value="#44476A" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#141524" />
      <Setter Property="BorderBrush" Value="{DynamicResource NexusAccent}" />
    </Style>
  </Application.Styles>
</Application>
